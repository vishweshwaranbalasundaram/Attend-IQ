# Copy to .env for local Docker Compose. Values below are local-only examples.
ATTENDIQ_DB_URL=jdbc:mysql://mysql:3306/attendiq_java?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ATTENDIQ_DB_USER=root
ATTENDIQ_DB_PASSWORD=replace-with-a-local-only-password
ATTENDIQ_MYSQL_ROOT_PASSWORD=replace-with-a-local-only-password
ATTENDIQ_MYSQL_PORT=3308
ATTENDIQ_API_PORT=8082
ATTENDIQ_WEB_ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=demo-attendiq
ALLOWED_EMAIL_DOMAIN=example.edu
ATTENDIQ_QR_HMAC_SECRET=replace-this-local-example-with-at-least-32-random-bytes
CAMPUS_LAT=0.0000 # Replace with the center of your campus
CAMPUS_LNG=0.0000
GEOFENCE_RADIUS_METERS=150
MAX_GPS_ACCURACY_METERS=50
ATTENDIQ_SESSION_MINUTES=10
ATTENDIQ_GRACE_MINUTES=5
ATTENDIQ_LATE_CUTOFF_MINUTES=10

# Public Firebase Web App settings (use the demo project with the emulator locally).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-attendiq
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-attendiq.appspot.com
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=example.edu

# Production Cloud Run settings; never put service-account keys in this file.
CLOUD_SQL_INSTANCE=your-project:us-central1:attendiq-mysql
ATTENDIQ_DB_NAME=attendiq_java
# For Cloud Run, set ATTENDIQ_DB_USER and ATTENDIQ_DB_PASSWORD in the service environment.
